{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "outDir": "./dist",

    "baseUrl": "./src",
    "paths": {
      "@routes/*": ["routes/*"],
      "@modules/*": ["modules/*"],
      "@middlewares/*": ["middlewares/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
